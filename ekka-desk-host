#!/usr/bin/python3 -I
"""EKKA's native host-administration entry point (no shell wrapper)."""
import os
from pathlib import Path
import stat
import sys

sys.dont_write_bytecode = True
# Never read cached bytecode either: a cache beside the sources is not part of what the trust check below inspects.
# A prefix that cannot be a folder makes every cache lookup miss, so modules always compile from their source.
sys.pycache_prefix = "/dev/null/ekka-desk-host"
HERE = Path(__file__).resolve().parent
INSTALLED = "/usr/local/lib/ekka-desks/ekka-desk-host"


def trusted(root):
    """True when root, its every parent and everything root imports or reads (this file, tools/, deploy/) belong
    to root and nobody else can change them: the root-owned copy the installer makes, never a person's checkout."""
    try:
        for part in [*reversed(root.parents), root]:
            info = part.lstat()
            if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
                return False
        def unreadable(error):
            raise error
        paths = [root / "ekka-desk-host"]
        for folder in ("tools", "deploy"):
            paths.append(root / folder)
            for base, folders, files in os.walk(root / folder, onerror=unreadable):
                paths.extend(Path(base) / name for name in folders + files)
        for path in paths:
            info = path.lstat()
            if stat.S_ISLNK(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
                return False
    except OSError:
        return False
    return True


if __name__ == "__main__":
    # As root, code is imported only from the installed root-owned copy; a person's checkout could change it.
    if os.geteuid() == 0 and not trusted(HERE):
        print("ekka-desk-host: run the installed copy, which only root can change: sudo " + INSTALLED,
              file=sys.stderr)
        sys.exit(2)
    sys.path.insert(0, str(HERE / "tools"))
    from ekka_host.cli import main
    sys.exit(main())
