#!/bin/sh
# Git's credential helper for the desk's GitHub connection. A clone names this file
# (-c credential.helper=/usr/local/bin/ekka-git-credential), so nobody writes a helper on the
# command line: Claude Code holds an inline `!f() { ...; }; f` helper for approval, and an unattended desk
# has nobody to approve it.
#
# It answers only `get`, only for https://github.com, and only when the desk has a GitHub connection.
# GITHUB_TOKEN is OpenShell's placeholder, never the real key: the gateway swaps it in on the way out.
[ "$1" = get ] || exit 0
protocol=
host=
while IFS='=' read -r key value; do
  case $key in
    protocol) protocol=$value ;;
    host) host=$value ;;
  esac
done
[ "$protocol" = https ] && [ "$host" = github.com ] && [ -n "${GITHUB_TOKEN:-}" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$GITHUB_TOKEN"
