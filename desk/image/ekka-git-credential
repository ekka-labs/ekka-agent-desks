#!/bin/sh
# Git's credential helper for the desk's source-control connections. A clone names this file
# (-c credential.helper=/usr/local/bin/ekka-git-credential), so nobody writes a helper on the
# command line: Claude Code holds an inline `!f() { ...; }; f` helper for approval, and an unattended desk
# has nobody to approve it.
#
# It answers only `get`, only over https, and only for a host whose connection the desk has:
#   github.com     GITHUB_TOKEN     username x-access-token
#   bitbucket.org  BITBUCKET_TOKEN  username x-bitbucket-api-token-auth (Bitbucket's fixed username for an
#                                   API token over git; an account email works for its REST API only)
# The tokens are OpenShell's placeholders, never the real key: the gateway swaps it in on the way out, and
# only to the hosts the provider's profile names.
[ "$1" = get ] || exit 0
protocol=
host=
while IFS='=' read -r key value; do
  case $key in
    protocol) protocol=$value ;;
    host) host=$value ;;
  esac
done
[ "$protocol" = https ] || exit 0
case $host in
  github.com)
    [ -n "${GITHUB_TOKEN:-}" ] || exit 0
    printf 'username=x-access-token\npassword=%s\n' "$GITHUB_TOKEN" ;;
  bitbucket.org)
    [ -n "${BITBUCKET_TOKEN:-}" ] || exit 0
    printf 'username=x-bitbucket-api-token-auth\npassword=%s\n' "$BITBUCKET_TOKEN" ;;
esac
